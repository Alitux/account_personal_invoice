<odoo>
  <data>
    <record id="view_move_form_inherit_personal_invoices" model="ir.ui.view">
      <field name="name">account.move.form.inherit.personal.invoices</field>
      <field name="model">account.move</field>
      <field name="inherit_id" ref="l10n_ar_afipws_fe.view_move_form"/>
      <field name="arch" type="xml">

        <xpath expr="//button[@name='action_post'][2]" position="attributes">
          <attribute name="groups">account.group_account_invoice,account_personal_invoice.group_account_personal_invoices</attribute>
        </xpath>

        <xpath expr="//button[@name='action_post'][3]" position="attributes">
          <attribute name="groups">account.group_account_invoice,account_personal_invoice.group_account_personal_invoices</attribute>
        </xpath>

        <xpath expr="//button[@name='get_pyafipws_currency_rate']" position="attributes">
          <attribute name="groups">account.group_account_invoice,account_personal_invoice.group_account_personal_invoices</attribute>
        </xpath>

      </field>
    </record>
  </data>
</odoo>
