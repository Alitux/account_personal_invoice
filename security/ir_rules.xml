<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="account_move_rule_personal_invoices" model="ir.rule">
            <field name="name">Personal Invoices</field>
            <field name="model_id" ref="account.model_account_move"/>
            <field name="global" eval="True"/>
            <field name="domain_force">[('move_type', 'in', ('out_invoice', 'out_refund')), ('invoice_user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('account_personal_invoices.group_account_personal_invoices'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

