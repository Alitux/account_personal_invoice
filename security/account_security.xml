<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Own privilege so it does not compete with Invoicing inside the
         Accounting privilege (Odoo 19 user form allows one selection per
         privilege, which used to silently drop the Invoicing group). -->
    <record id="res_groups_privilege_personal_invoices" model="res.groups.privilege">
        <field name="name">Personal Invoices</field>
        <field name="sequence">71</field>
        <field name="category_id" ref="base.module_category_accounting_accounting"/>
    </record>

    <record id="group_account_personal_invoices" model="res.groups">
        <field name="name">Personal Invoices</field>
        <field name="privilege_id" ref="res_groups_privilege_personal_invoices"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

</odoo>
